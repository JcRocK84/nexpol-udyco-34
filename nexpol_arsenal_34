<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UDYCO: Reto T34 · Drogodependencias</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --primary:#0B2E6B;
    --primary-2:#123B8C;
    --primary-light:#2E63E9;
    --accent:#FFB020;
    --depresora:#4C6EF5;
    --estimulante:#F76707;
    --alucinogena:#7C4DFF;
    --bg:#F1F5FC;
    --card:#FFFFFF;
    --text:#12213D;
    --muted:#5B6B8C;
    --ok:#1E9E6B;
    --bad:#E0393E;
    --radius:18px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:'Inter',sans-serif; background:var(--bg); color:var(--text);
    min-height:100vh;
  }
  h1,h2,h3,.display{font-family:'Poppins',sans-serif; font-weight:800;}
  .hidden{display:none !important;}

  /* GATE */
  #gate{min-height:100vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,var(--primary) 0%, var(--primary-2) 60%, #1849A8 100%);}
  .gate-card{background:var(--card); padding:36px 32px; border-radius:24px; width:min(380px,90vw); text-align:center; box-shadow:0 20px 50px rgba(0,0,0,.3);}
  .gate-card h1{color:var(--primary); font-size:22px; margin:0 0 4px;}
  .gate-card p{color:var(--muted); font-size:14px; margin-top:0;}
  .gate-card input{width:100%; padding:12px 14px; border-radius:12px; border:2px solid #DCE4F5; font-size:15px; margin:14px 0; outline:none;}
  .gate-card input:focus{border-color:var(--primary-light);}
  .btn{
    background:var(--primary-light); color:#fff; border:none; padding:12px 20px; border-radius:14px;
    font-weight:700; font-family:'Inter',sans-serif; font-size:15px; cursor:pointer; transition:.15s;
  }
  .btn:hover{transform:translateY(-2px); box-shadow:0 8px 18px rgba(46,99,233,.35);}
  .btn.full{width:100%;}
  .btn.ghost{background:transparent; color:var(--primary-light); border:2px solid var(--primary-light);}
  .gate-error{color:var(--bad); font-size:13px; height:16px;}

  /* APP SHELL */
  #app{max-width:980px; margin:0 auto; padding:18px 16px 60px;}
  header.top{
    background:linear-gradient(120deg,var(--primary),var(--primary-2));
    color:#fff; border-radius:22px; padding:20px 24px; display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:14px; margin-bottom:20px;
  }
  header.top .brand{display:flex; align-items:center; gap:12px;}
  .header-right{display:flex; align-items:center; gap:12px; flex-wrap:wrap;}
  header.top .brand .badge{
    width:46px; height:46px; border-radius:14px; background:var(--accent); display:flex; align-items:center;
    justify-content:center; font-size:22px; font-weight:800; color:var(--primary);
  }
  header.top h1{font-size:19px; margin:0; line-height:1.15;}
  header.top .sub{font-size:12px; opacity:.85; margin:0;}
  .xpbox{background:rgba(255,255,255,.12); border-radius:14px; padding:10px 16px; min-width:190px;}
  .xpbox .rank{font-weight:700; font-size:14px;}
  .xpbox .bar{background:rgba(255,255,255,.25); height:8px; border-radius:6px; margin-top:6px; overflow:hidden;}
  .xpbox .fill{height:100%; background:var(--accent); border-radius:6px; transition:width .4s;}
  .xpbox .xpnum{font-size:11px; opacity:.85; margin-top:4px;}

  /* HUB */
  .grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;}
  .mode-card{
    background:var(--card); border-radius:20px; padding:22px; cursor:pointer; border:2px solid transparent;
    transition:.15s; position:relative; overflow:hidden;
  }
  .mode-card:hover{transform:translateY(-4px); border-color:var(--primary-light); box-shadow:0 14px 30px rgba(11,46,107,.12);}
  .mode-card .icon{font-size:34px; margin-bottom:10px; display:block;}
  .mode-card h3{margin:0 0 6px; font-size:16px; color:var(--primary);}
  .mode-card p{margin:0; font-size:13px; color:var(--muted); line-height:1.4;}
  .mode-card .stripe{position:absolute; top:0; left:0; width:6px; height:100%;}

  /* GAME CONTAINER */
  .panel{background:var(--card); border-radius:20px; padding:24px; margin-bottom:16px;}
  .panel-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:8px;}
  .panel-head h2{margin:0; font-size:18px; color:var(--primary);}
  .backbtn{background:#EAF0FC; color:var(--primary); border:none; padding:8px 14px; border-radius:10px; font-weight:700; cursor:pointer; font-size:13px;}

  .catbox{
    border-radius:16px; padding:16px; text-align:center; font-weight:700; color:#fff; cursor:pointer;
    transition:.15s; font-size:15px; min-height:90px; display:flex; align-items:center; justify-content:center;
  }
  .catbox:hover{transform:scale(1.03);}
  .catbox.depresora{background:var(--depresora);}
  .catbox.estimulante{background:var(--estimulante);}
  .catbox.alucinogena{background:var(--alucinogena);}
  .drug-term{
    text-align:center; font-size:26px; font-weight:800; color:var(--primary); padding:30px 10px;
    background:#EAF0FC; border-radius:16px; margin-bottom:18px;
  }
  .cat-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:12px;}
  @media(max-width:560px){.cat-grid{grid-template-columns:1fr;}}

  .progressline{display:flex; align-items:center; gap:10px; margin-bottom:14px; font-size:13px; color:var(--muted); font-weight:600;}
  .lives{display:flex; gap:4px;}
  .flash{font-size:13px; font-weight:700; text-align:center; padding:8px; border-radius:10px; margin-bottom:10px;}
  .flash.ok{background:#E2F7EE; color:var(--ok);}
  .flash.bad{background:#FDEBEC; color:var(--bad);}

  /* MEMORY */
  .memgrid{display:grid; grid-template-columns:repeat(4,1fr); gap:10px;}
  @media(max-width:560px){.memgrid{grid-template-columns:repeat(3,1fr);}}
  .memcard{
    background:var(--primary-light); border-radius:12px; min-height:78px; display:flex; align-items:center;
    justify-content:center; text-align:center; font-size:12px; font-weight:700; color:#fff; padding:6px; cursor:pointer;
    user-select:none; transition:.15s; line-height:1.15; word-break:break-word;
  }
  .memcard.small-text{font-size:10px;}
  .memcard.flipped{background:#fff; color:var(--primary); border:2px solid var(--primary-light);}
  .memcard.matched{background:#E2F7EE; color:var(--ok); border:2px solid var(--ok); cursor:default;}

  /* TF */
  .tf-card{background:#EAF0FC; border-radius:16px; padding:26px 18px; text-align:center; font-size:16px; font-weight:600; color:var(--text); margin-bottom:16px; min-height:70px; display:flex; align-items:center; justify-content:center;}
  .tf-btns{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  .tf-btns button{padding:16px; border-radius:14px; border:none; font-weight:800; font-size:15px; cursor:pointer; color:#fff;}
  .tf-btns .vbtn{background:var(--ok);}
  .tf-btns .fbtn{background:var(--bad);}

  /* ORG */
  .org-wrap{display:flex; flex-direction:column; gap:10px;}
  .org-row{display:flex; gap:10px; align-items:stretch; flex-wrap:wrap;}
  .org-pill{
    flex:1; min-width:140px; background:#EAF0FC; border-radius:12px; padding:12px; font-size:13px; font-weight:700;
    color:var(--primary); text-align:center; cursor:pointer; border:2px solid transparent;
  }
  .org-pill.selected{border-color:var(--primary-light); background:#D9E6FF;}
  .org-pill.matched{background:#E2F7EE; border-color:var(--ok); color:var(--ok); cursor:default;}
  .org-func{
    background:#fff; border:2px dashed #C6D3EF; border-radius:12px; padding:12px; font-size:12.5px; color:var(--muted);
    text-align:center; cursor:pointer;
  }
  .org-func.selected{border-color:var(--accent); background:#FFF6E5;}
  .org-func.matched{background:#E2F7EE; border-color:var(--ok); color:var(--ok); cursor:default; border-style:solid;}

  /* EXAM */
  .exam-q{background:#EAF0FC; border-radius:16px; padding:20px; font-size:15px; font-weight:600; margin-bottom:16px; line-height:1.5;}
  .exam-opt{
    display:block; width:100%; text-align:left; background:#fff; border:2px solid #DCE4F5; border-radius:12px;
    padding:12px 16px; margin-bottom:10px; font-size:14px; cursor:pointer; font-family:'Inter',sans-serif; color:var(--text);
  }
  .exam-opt:hover{border-color:var(--primary-light);}
  .exam-opt:disabled{cursor:default; opacity:.6;}
  .exam-opt.correct{background:#E2F7EE; border-color:var(--ok); color:var(--ok); font-weight:700; opacity:1 !important;}
  .exam-opt.incorrect{background:#FDEBEC; border-color:var(--bad); color:var(--bad); font-weight:700; opacity:1 !important;}
  .box-tag{display:inline-block; font-size:11px; background:#D9E6FF; color:var(--primary); padding:3px 10px; border-radius:20px; font-weight:700; margin-left:6px;}

  .result-box{text-align:center; padding:28px 16px;}
  .result-box .big{font-size:42px; font-weight:800; color:var(--primary); margin-bottom:6px;}
  .result-box p{color:var(--muted); margin:4px 0 18px;}

  .name-row{display:flex; gap:10px; align-items:center; margin-bottom:14px; flex-wrap:wrap;}
  .name-row input{padding:9px 12px; border-radius:10px; border:2px solid #DCE4F5; font-size:13px; flex:1; min-width:140px;}

  .leader{margin-top:8px;}
  .leader table{width:100%; border-collapse:collapse; font-size:13px;}
  .leader th{text-align:left; color:var(--muted); font-weight:700; padding:6px 8px; font-size:11px; text-transform:uppercase;}
  .leader td{padding:8px; border-top:1px solid #EEF2FB;}
  .leader tr:first-child td{font-weight:800; color:var(--primary);}

  /* ---- PULIDO VISUAL GENERAL ---- */
  header.top{
    box-shadow:0 12px 30px rgba(11,46,107,.28);
    background-image:
      radial-gradient(circle at 90% -10%, rgba(255,176,32,.18) 0%, transparent 55%),
      linear-gradient(120deg,var(--primary),var(--primary-2));
  }
  .panel{box-shadow:0 6px 20px rgba(18,33,61,.06); border:1px solid #EAF0FC;}
  .mode-card{box-shadow:0 4px 14px rgba(18,33,61,.05);}
  .mode-card .icon{
    display:inline-flex; align-items:center; justify-content:center; width:52px; height:52px;
    border-radius:14px; background:#EAF0FC; margin-bottom:12px;
  }
  @keyframes flashIn{from{opacity:0; transform:translateY(-6px);} to{opacity:1; transform:translateY(0);}}
  .flash{animation:flashIn .25s ease-out;}
  .btn{box-shadow:0 6px 16px rgba(46,99,233,.25);}
  .catbox{box-shadow:0 6px 14px rgba(18,33,61,.12);}

  /* Botón "Siguiente" tras responder */
  .nextbtn{margin-top:14px; font-size:15px;}

  /* ---- MODAL GLOSARIO ---- */
  .modal-overlay{
    position:fixed; inset:0; background:rgba(10,20,45,.6); display:flex; align-items:center; justify-content:center;
    z-index:200; padding:16px; backdrop-filter:blur(2px);
  }
  .modal-box{
    background:var(--card); border-radius:20px; width:min(640px,100%); max-height:85vh; display:flex; flex-direction:column;
    box-shadow:0 30px 70px rgba(0,0,0,.35); overflow:hidden;
  }
  .modal-head{display:flex; align-items:center; justify-content:space-between; padding:18px 20px 10px;}
  .modal-head h2{margin:0; font-size:17px; color:var(--primary);}
  .closebtn{background:#EAF0FC; color:var(--primary); border:none; width:32px; height:32px; border-radius:10px; font-weight:800; cursor:pointer; font-size:14px;}
  .gloss-search{
    margin:0 20px 12px; padding:11px 14px; border-radius:12px; border:2px solid #DCE4F5; font-size:13.5px;
    font-family:'Inter',sans-serif;
  }
  .gloss-tabs{display:flex; gap:6px; padding:0 20px 12px; flex-wrap:wrap;}
  .gloss-tab{
    background:#EAF0FC; color:var(--primary); border:none; padding:6px 12px; border-radius:20px; font-size:11.5px;
    font-weight:700; cursor:pointer;
  }
  .gloss-tab.active{background:var(--primary-light); color:#fff;}
  .gloss-list{overflow-y:auto; padding:0 20px 20px; flex:1;}
  .gloss-item{padding:12px 0; border-top:1px solid #EEF2FB;}
  .gloss-item:first-child{border-top:none;}
  .gloss-term{font-weight:800; color:var(--primary); font-size:14px; margin-bottom:3px;}
  .gloss-term .tagpill{
    font-size:10px; font-weight:700; background:#EAF0FC; color:var(--muted); padding:2px 8px; border-radius:10px;
    margin-left:8px; vertical-align:middle;
  }
  .gloss-def{font-size:13px; color:var(--muted); line-height:1.5;}
  .gloss-empty{text-align:center; color:var(--muted); font-size:13px; padding:30px 0;}
</style>
</head>
<body>

<!-- PASSWORD GATE -->
<div id="gate">
  <div class="gate-card">
    <div style="font-size:34px;">🛡️</div>
    <h1>UDYCO: Reto T34</h1>
    <p>Academia Ángeles Custodios — Escala Básica CNP</p>
    <input type="password" id="gatePass" placeholder="Contraseña de acceso" onkeydown="if(event.key==='Enter')checkGate()">
    <div class="gate-error" id="gateError"></div>
    <button class="btn full" onclick="checkGate()">Entrar</button>
  </div>
</div>

<!-- APP -->
<div id="app" class="hidden">
  <header class="top">
    <div class="brand">
      <div class="badge">34</div>
      <div>
        <h1>UDYCO: Reto T34</h1>
        <p class="sub">5 modos de juego para dominar el Tema 34</p>
      </div>
    </div>
    <div class="header-right">
      <div class="xpbox">
        <div class="rank" id="rankLabel">Novato · 0 XP</div>
        <div class="bar"><div class="fill" id="xpFill" style="width:0%"></div></div>
        <div class="xpnum" id="xpNext">Próximo rango: 100 XP</div>
      </div>
    </div>
  </header>

  <!-- HUB -->
  <div id="hub">
    <div class="grid">
      <div class="mode-card" onclick="openMode('classify')">
        <div class="stripe" style="background:var(--depresora)"></div>
        <span class="icon">🎯</span>
        <h3>Clasifica la Sustancia</h3>
        <p>Depresora, estimulante o alucinógena. Rondas con dificultad progresiva.</p>
      </div>
      <div class="mode-card" onclick="openMode('memory')">
        <div class="stripe" style="background:var(--primary-light)"></div>
        <span class="icon">🃏</span>
        <h3>Memoria de Apodos</h3>
        <p>Empareja el nombre técnico con su argot callejero.</p>
      </div>
      <div class="mode-card" onclick="openMode('tf')">
        <div class="stripe" style="background:var(--accent)"></div>
        <span class="icon">⚡</span>
        <h3>Verdadero o Falso</h3>
        <p>Contrarreloj, con combos de aciertos consecutivos.</p>
      </div>
      <div class="mode-card" onclick="openMode('org')">
        <div class="stripe" style="background:var(--alucinogena)"></div>
        <span class="icon">🏛️</span>
        <h3>Organigrama Institucional</h3>
        <p>SEAT, OEDA, CITCO, JIFE, REITOX... conecta cada organismo con su función.</p>
      </div>
      <div class="mode-card" onclick="openMode('exam')">
        <div class="stripe" style="background:var(--ok)"></div>
        <span class="icon">📝</span>
        <h3>Examen Adaptativo</h3>
        <p>Preguntas oficiales de convocatorias con repetición espaciada (Leitner).</p>
      </div>
      <div class="mode-card" onclick="openGlossary()">
        <div class="stripe" style="background:#5B6B8C"></div>
        <span class="icon">📖</span>
        <h3>Glosario Completo</h3>
        <p>Toda la terminología del tema: sustancias, conceptos, síndromes e instituciones. Con buscador.</p>
      </div>
    </div>

    <div class="panel leader" style="margin-top:18px;">
      <div class="panel-head"><h2>🏆 Ranking general</h2></div>
      <div class="name-row">
        <input id="playerName" placeholder="Tu nombre para el ranking" oninput="savePlayerName()">
      </div>
      <div id="leaderTable">Cargando ranking...</div>
    </div>
  </div>

  <!-- MODE: CLASSIFY -->
  <div id="mode-classify" class="hidden">
    <div class="panel">
      <div class="panel-head">
        <h2>🎯 Clasifica la Sustancia</h2>
        <button class="backbtn" onclick="backToHub()">← Menú</button>
      </div>
      <div class="progressline">
        <span id="clRound">Ronda 1/12</span>
        <span>·</span>
        <span id="clScore">0 pts</span>
        <span>·</span>
        <span class="lives" id="clLives"></span>
      </div>
      <div class="flash hidden" id="clFlash"></div>
      <div class="drug-term" id="clTerm">—</div>
      <div class="cat-grid" id="clCatGrid">
        <div class="catbox depresora" onclick="clAnswer('Depresora')">😴 Depresora</div>
        <div class="catbox estimulante" onclick="clAnswer('Estimulante')">⚡ Estimulante</div>
        <div class="catbox alucinogena" onclick="clAnswer('Alucinógena')">🌀 Alucinógena</div>
      </div>
      <button class="btn full nextbtn hidden" id="clNextBtn" onclick="clContinue()">Siguiente ▶</button>
    </div>
    <div class="panel hidden" id="clResultPanel"></div>
  </div>

  <!-- MODE: MEMORY -->
  <div id="mode-memory" class="hidden">
    <div class="panel">
      <div class="panel-head">
        <h2>🃏 Memoria de Apodos</h2>
        <button class="backbtn" onclick="backToHub()">← Menú</button>
      </div>
      <div class="progressline">
        <span id="memMoves">0 intentos</span>
        <span>·</span>
        <span id="memTime">0s</span>
        <span>·</span>
        <span id="memPairs">0/8 parejas</span>
      </div>
      <div class="memgrid" id="memGrid"></div>
    </div>
    <div class="panel hidden" id="memResultPanel"></div>
  </div>

  <!-- MODE: TF -->
  <div id="mode-tf" class="hidden">
    <div class="panel">
      <div class="panel-head">
        <h2>⚡ Verdadero o Falso</h2>
        <button class="backbtn" onclick="backToHub()">← Menú</button>
      </div>
      <div class="progressline">
        <span id="tfTimer">60s</span>
        <span>·</span>
        <span id="tfScore">0 pts</span>
        <span>·</span>
        <span id="tfCombo">Combo x1</span>
      </div>
      <div class="flash hidden" id="tfFlash"></div>
      <div class="tf-card" id="tfCard">—</div>
      <div class="tf-btns" id="tfBtns">
        <button class="vbtn" onclick="tfAnswer(true)">✔ Verdadero</button>
        <button class="fbtn" onclick="tfAnswer(false)">✘ Falso</button>
      </div>
      <button class="btn full nextbtn hidden" id="tfNextBtn" onclick="tfContinue()">Siguiente ▶</button>
    </div>
    <div class="panel hidden" id="tfResultPanel"></div>
  </div>

  <!-- MODE: ORG -->
  <div id="mode-org" class="hidden">
    <div class="panel">
      <div class="panel-head">
        <h2>🏛️ Organigrama Institucional</h2>
        <button class="backbtn" onclick="backToHub()">← Menú</button>
      </div>
      <div class="progressline">
        <span id="orgPairsLeft">0/8 emparejados</span>
        <span>·</span>
        <span id="orgErrors">0 fallos</span>
      </div>
      <p style="font-size:12.5px; color:var(--muted); margin-top:0;">Toca un organismo y después su función correspondiente.</p>
      <div class="org-wrap" id="orgWrap"></div>
    </div>
    <div class="panel hidden" id="orgResultPanel"></div>
  </div>

  <!-- MODE: EXAM -->
  <div id="mode-exam" class="hidden">
    <div class="panel">
      <div class="panel-head">
        <h2>📝 Examen Adaptativo</h2>
        <button class="backbtn" onclick="backToHub()">← Menú</button>
      </div>
      <div class="progressline">
        <span id="exProgress">Pregunta 1/15</span>
        <span>·</span>
        <span id="exScore">0 pts</span>
      </div>
      <div class="exam-q" id="exQ">—</div>
      <div id="exOpts"></div>
      <button class="btn full nextbtn hidden" id="exNextBtn" onclick="exContinue()">Siguiente ▶</button>
    </div>
    <div class="panel hidden" id="exResultPanel"></div>
  </div>

</div>

<!-- GLOSARIO MODAL -->
<div id="glossaryModal" class="modal-overlay hidden" onclick="if(event.target===this)closeGlossary()">
  <div class="modal-box">
    <div class="modal-head">
      <h2>📖 Glosario · Tema 34</h2>
      <button class="closebtn" onclick="closeGlossary()">✕</button>
    </div>
    <input id="glossSearch" class="gloss-search" placeholder="Buscar término... (ej. tolerancia, SEAT, heroína)" oninput="renderGlossary()">
    <div class="gloss-tabs" id="glossTabs"></div>
    <div class="